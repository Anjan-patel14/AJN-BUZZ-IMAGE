{
  "name": "ajn-buzz-image",
  "version": "6.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "NODE_ENV=production NODE_OPTIONS='--import ./scripts/eslint-loader.mjs' next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "node --import ./scripts/eslint-loader.mjs ./node_modules/eslint/bin/eslint.js src",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "check": "npm run verify && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "jszip": "3.10.1",
    "lucide-react": "1.33.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "20.17.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "15.5.28",
    "typescript": "5.7.3"
  },
  "overrides": {
    "minimatch": "11.0.2",
    "postcss": "8.5.32",
    "sharp": "0.35.5"
  }
}

# Canonical production URLs (used for canonical tags, sitemaps, OpenGraph, and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.ajn.buzz
NEXT_PUBLIC_APP_URL=https://www.ajn.buzz

# Google AdSense configuration
# Publisher client ID (matches <head> script & ads.txt)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-4495802176396975

# Keep manual AdSlot placements disabled ("false") unless valid AdSense slot IDs are configured below
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=

# Client-side image processing limits
NEXT_PUBLIC_IMAGE_MAX_INPUT_MB=30
NEXT_PUBLIC_IMAGE_BATCH_LIMIT=20